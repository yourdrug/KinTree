# Application environment:
# DEV / TEST / PROD
ENVIRONMENT=DEV

# Allowed origins for frontend (JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database host:
# - "postgres" → if using Docker (service name)
# - "localhost" or IP → if external DB
DB_HOST=localhost

# Database name
DB_NAME=app_db

# Database user
DB_USER=app_user

# Database password
DB_PASSWORD=strong_password

# Database port (default: 5432)
DB_PORT=5432

# Redis connection URL
# Format:
# redis://[:password]@host:port/db

# Examples:
# - Docker: redis://redis:6379/0
# - Local:  redis://localhost:6379/0
# - Remote: redis://:password@192.168.1.10:6379/0
REDIS_URL=redis://localhost:6379/0

# Secret key for JWT/signing (use a long random string!)
SECRET_KEY=your_secret_key_here

# Access token lifetime in minutes
JWT_TOKEN_ACCESS_LIFETIME_MINUTES=15

# Refresh token lifetime in days
JWT_TOKEN_REFRESH_LIFETIME_DAYS=30

# Google client id (for OAuth)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Google client secret key (for OAuth)
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Google redirect url for oauth callback
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/oauth/google/callback

# Telegram bot token (for Telegram OAuth/login)
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff

# Resend API key for sending emails
# Generate here: https://resend.com/api-keys
RESEND_API_KEY=re_xxxx

# Sender email address used for outgoing emails
# Example:
# - delivered@resend.dev (testing)
# - noreply@yourdomain.com (production)
EMAIL_FROM=delivered@resend.dev

# Frontend application base URL
# Used for links in emails
FRONTEND_URL=http://localhost:3000

# Frontend OAuth callback URL
# User will be redirected here after OAuth login
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:3000/oauth/callback

# Example: Europe/Berlin, Europe/Minsk, UTC
TIMEZONE=UTC
