# Application environment:
# DEV / TEST / PROD
ENVIRONMENT=DEV

# Allowed origins for frontend (JSON array)
# Example: ["http://localhost:3000"]
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database host:
# - "postgres" → if using Docker (service name)
# - "localhost" or IP → if external DB
DB_HOST=localhost

# Database name
DB_NAME=app_db

# Database user
DB_USER=app_user

# Database password
DB_PASSWORD=strong_password

# Database port (default: 5432)
DB_PORT=5432


# Redis connection URL
# Format:
# redis://[:password]@host:port/db

# Examples:
# - Docker: redis://redis:6379/0
# - Local:  redis://localhost:6379/0
# - Remote: redis://:password@192.168.1.10:6379/0
REDIS_URL=redis://localhost:6379/0

# Secret key for JWT/signing (use a long random string!)
SECRET_KEY=your_secret_key_here

# Access token lifetime in minutes
JWT_TOKEN_ACCESS_LIFETIME_MINUTES=15

# Refresh token lifetime in days
JWT_TOKEN_REFRESH_LIFETIME_DAYS=30

# Example: Europe/Berlin, Europe/Minsk, UTC
TIMEZONE=UTC
